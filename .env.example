# Voice. With no key, reelkit uses Kokoro: a free, local, open-weights voice (npm run doctor -- --fix downloads it).
# Keys below are optional upgrades.

# ElevenLabs: most expressive voice, word timing from the API. https://elevenlabs.io → Profile → API keys
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# OpenAI TTS: good quality, paid per use
OPENAI_API_KEY=

# Piper: free and offline, but many voices (all Lessac-based ones) are non-commercial. Check the voice's MODEL_CARD.
# PIPER_MODEL=/path/to/en_US-joe-medium.onnx
