# Voice. Pick one (or none for silent drafts). On macOS the built-in `say` voice works with no key.
# ElevenLabs: best quality + exact word timing. https://elevenlabs.io → Profile → API keys
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb

# OpenAI TTS: good quality, word timing estimated
OPENAI_API_KEY=

# Piper: free, offline, open-source. pip install piper-tts, download a voice, point to the .onnx file
# PIPER_MODEL=/path/to/en_US-lessac-medium.onnx
