    "render": "node scripts/render.mjs",
    "preview": "node scripts/preview.mjs",
    "test": "node tests/run.mjs",
    "ref": "node scripts/ref.mjs",
    "clip": "node scripts/clip.mjs",
    "score": "node scripts/score.mjs",
    "depth": "node scripts/depth.mjs",
